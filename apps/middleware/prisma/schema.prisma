generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 제조사. code로 코드의 어댑터 class를 찾는다.
model vendors {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors_connections vendors_connections[]
}

/// 연결 설정. 행 하나가 어댑터 인스턴스 하나다.
model vendors_connections {
  id         String   @id @default(uuid()) @db.Uuid
  vendors_id String   @db.Uuid
  name       String   @unique
  protocol   String   @db.VarChar(20)
  enabled    Boolean  @default(true)
  config     Json
  version    Int      @default(1)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors                     vendors                       @relation(fields: [vendors_id], references: [id])
  vendors_connections_devices vendors_connections_devices[]
}

/// 로봇과 PLC 장비. id가 공통 모델의 deviceId다.
model vendors_connections_devices {
  id                     String   @id @default(uuid()) @db.Uuid
  vendors_connections_id String   @db.Uuid
  external_id            String
  type                   String   @db.VarChar(20)
  name                   String
  enabled                Boolean  @default(true)
  created_at             DateTime @default(now()) @db.Timestamptz
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors_connections                    vendors_connections                      @relation(fields: [vendors_connections_id], references: [id])
  vendors_connections_devices_telemetry  vendors_connections_devices_telemetry[]
  vendors_connections_devices_plc_points vendors_connections_devices_plc_points[]

  @@unique([vendors_connections_id, external_id])
}

/// 받아들인 로봇 상태 전부. 초당 90행.
model vendors_connections_devices_telemetry {
  id                             BigInt   @id @default(autoincrement())
  vendors_connections_devices_id String   @db.Uuid
  seq                            BigInt
  source_ts                      DateTime @db.Timestamptz
  received_ts                    DateTime @db.Timestamptz
  x                              Float    @db.Real
  y                              Float    @db.Real
  theta                          Float    @db.Real
  speed                          Float    @db.Real
  battery_pct                    Int      @db.SmallInt
  op_state                       String   @db.VarChar(20)
  error_code                     String?
  loaded                         Boolean
  created_at                     DateTime @default(now()) @db.Timestamptz
  updated_at                     DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors_connections_devices vendors_connections_devices @relation(fields: [vendors_connections_devices_id], references: [id])

  @@index([vendors_connections_devices_id, source_ts(sort: Desc)])
  /// 보관 기간이 지난 행을 지울 때 쓴다.
  @@index([received_ts])
}

/// PLC 16점의 의미.
model vendors_connections_devices_plc_points {
  id                             String   @id @default(uuid()) @db.Uuid
  vendors_connections_devices_id String   @db.Uuid
  point_no                       Int      @db.SmallInt
  name                           String
  type                           String   @db.VarChar(20)
  normal_value                   Boolean
  alarm_on_abnormal              Boolean  @default(false)
  created_at                     DateTime @default(now()) @db.Timestamptz
  updated_at                     DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors_connections_devices                   vendors_connections_devices                     @relation(fields: [vendors_connections_devices_id], references: [id])
  vendors_connections_devices_plc_points_events vendors_connections_devices_plc_points_events[]

  @@unique([vendors_connections_devices_id, point_no])
}

/// PLC 점의 값이 바뀔 때만 한 행.
model vendors_connections_devices_plc_points_events {
  id                                        BigInt   @id @default(autoincrement())
  vendors_connections_devices_plc_points_id String   @db.Uuid
  value                                     Boolean
  seq                                       BigInt
  source_ts                                 DateTime @db.Timestamptz
  received_ts                               DateTime @db.Timestamptz
  created_at                                DateTime @default(now()) @db.Timestamptz
  updated_at                                DateTime @default(now()) @updatedAt @db.Timestamptz

  vendors_connections_devices_plc_points vendors_connections_devices_plc_points @relation(fields: [vendors_connections_devices_plc_points_id], references: [id])

  @@index([vendors_connections_devices_plc_points_id, source_ts(sort: Desc)])
  /// 보관 기간이 지난 행을 지울 때 쓴다.
  @@index([received_ts])
}

/// 연결 기록과 알람을 쌓는 시스템 로그. 추가만 한다.
model logs {
  id          BigInt   @id @default(autoincrement())
  type        String   @db.VarChar(20)
  level       String   @db.VarChar(10)
  alarm_code  String?  @db.VarChar(20)
  target_type String   @db.VarChar(20)
  target_id   String   @db.Uuid
  message     String
  /// 알람을 확인하거나 연결 설정을 바꾼 사용자. ALARM_ACKED, CONFIG_CHANGED일 때만
  users_id    String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  users users? @relation(fields: [users_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@index([target_type, target_id, created_at(sort: Desc)])
}

/// 권한 역할. code는 VIEWER(조회), OPERATOR(알람 확인), ADMIN(연결 설정 변경)
model roles {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  user_roles user_roles[]
}

/// 데모 계정. password_hash는 argon2id. 역할은 user_roles로 잇는다.
model users {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz

  user_roles user_roles[]
  logs       logs[]
}

/// 사용자와 역할의 매핑. 한 사용자가 여러 역할을 가질 수 있다.
model user_roles {
  users_id   String   @db.Uuid
  roles_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  users users @relation(fields: [users_id], references: [id])
  roles roles @relation(fields: [roles_id], references: [id])

  @@id([users_id, roles_id])
}
