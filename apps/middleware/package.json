{
  "name": "middleware",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:migrate": "prisma migrate deploy",
    "start:prod": "prisma migrate deploy && pnpm prisma:seed && node dist/main.js",
    "prisma:seed": "prisma db execute --file prisma/seed.sql --schema prisma/schema.prisma",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/platform-ws": "11.2.11",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/websockets": "11.2.11",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "bullmq": "6.5.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "ioredis": "5.11.1",
    "modbus-serial": "8.0.25",
    "mqtt": "5.16.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src"
  }
}
